# Google Gemini API Key (Required for Visualization Engine)
API_KEY=your_google_gemini_key

# Anthropic API Key (Required for Regression Evaluation)
ANTHROPIC_API_KEY=sk-ant-xxx

# Backend API URL (for Frontend)
VITE_API_URL=http://localhost:8080

# Which deployed environment this process represents: 'qa' or 'prod'. Set by the
# Cloud Run deploy workflows; only useful locally for reproducing env-specific
# behaviour. See docs/ENVIRONMENTS.md.
VIS_ENV=qa
